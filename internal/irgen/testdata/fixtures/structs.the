interface P {
    fn do();
    fn donot() {
        println("no");
    }
}
struct Person1 impl P {
    String name;
    mut uint32 age;
    String nickname;

    private {
        int id = 1;
        fn increaseAge() {
            age += 1;
        }
    }

    fn greet() {
        mut String alt = "";
        if (nickname != "") {
            alt = ", but you can call me " + nickname;
        }
        println("My name is " + name + alt + "; I am " + age as String + " years old.");
    }

    cast {
        fn toInt() -> int {
            return 0;
        }
    }
    P {
        fn do() {
            println("hi");
        }
    }

}

