int x = 1;
interface P {
    fn do();
    fn donot() {
        println("no");
    }
}
struct Person1 impl P {
    String name;
    mut uint32 age;
    String nickname;

    private {
        int id = 1;
        fn increaseAge() {
            age += 1;
        }
    }

    fn setAge(uint32 age) {
        this.age = age;
    }
    fn greet() {
        mut String alt = "";
        if (nickname != "") {
            alt = ", but you can call me " + nickname;
        }
        println("My name is " + name + alt + "; I am " + age as String + " years old.");
    }

    cast {
        fn toInt() -> int {
            return 0;
        }
    }
    P {
        fn do() {
            println("hi");
        }
    }

}

struct Inner {
    int id;

    fn getId() -> int {
        println(this.id);
        return id;
    }

    fn showX() {
        println(x);
        println(global.x);
    }

    cast {
        fn toString() -> String {
            return id as String;
        }
    }

    compare {
        fn equals(Inner other) -> bool {
            return id == other.id;
        }
        fn lessThan(Inner other) -> bool {
            return id < other.id;
        }
        fn greaterThan(Inner other) -> bool {
            return id > other.id;
        }
    }
}

fn testInnerCompare(Inner i, Inner i2) -> Inner {
    if (i == i2)
        return i;
    if (i <= i2)
        return i;
    if (i >= i2)
        return i2;
    return i2;
}

struct Nested {
    double id;
    Inner inner;
    String description;
}

