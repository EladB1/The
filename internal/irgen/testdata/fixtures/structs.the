struct Person1 {
    String name;
    uint32 age;
    String nickname;

    private {
        int id = 1;
    }

    fn greet() {
        println("My name is " + name + " and I am " + (this.age as String) + " years old");
    }
}

fn main() -> int {
    Person1 p = Person1{name: "A", age: 112};
    uint32 age = p.age;
    mut Person1 p2 = Person1{name: "B"};
    println(p2);
    p2.age = 25;
    p2.age += 2;
    return 0;
}