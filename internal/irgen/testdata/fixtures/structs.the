interface P {
    fn do();
}
struct Person1 impl P {
    String name;
    uint32 age;
    String nickname;

    private {
        int id = 1;
    }

    fn greet() {
        mut String alt = "";
        if (nickname != "") {
            alt = ", but you can call me " + nickname;
        }
        println("My name is " + name + alt + "; I am " + age as String + " years old.");
    }

    cast {
        fn toInt() -> int {
            return 0;
        }
    }
    P {
        fn do() {}
    }

}

fn main() -> int {
    // Person1 p = Person1{name: "A", age: 112};
    // uint32 age = p.age;
    mut Person1 p2 = Person1{name: "B"};
    p2.age = 25;
    p2.age += 2;
    p2.greet();
    // println(p2);
   
    return 0;
}