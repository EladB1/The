fn main() -> int {
    String str = "hello, world";
    println(str);
    testStrIndex(str);
    testStrMethods(str);
    testCasts();
    testStrComparisons("hello", "halo");
    return 0;
}

fn testStrIndex(String str) {
    println(str[1]);
    //println(str[27000]);
    println(str[^1]);
    println(str[1..4]);
    println(str[1..=4]);
    println(str.startsWith("hello"));
}

fn testStrMethods(String str) {
    println(str.reverse());
    println(str.startsWith("hello"));
    println(str.startsWith("helo"));
    println(str.endsWith("world"));
    println(str.endsWith("RLD"));
    println(str.contains('l'));
    println(str.contains('L'));
    println(str.contains("ll"));
    println(str.contains("abc"));
    println(str.contains(""));
    println(str.toUpper());
    println("HELLO".toLower());
    print("  abc    ".trim());
    print(" abc".trimStart());
    print("abc  ".trimEnd());
    println("");
}

fn testCasts() {
    println(92);
    println(1);
    println(-45);
    println('c');
    println(true);
    int64 i = -221;
    println(i);
}

fn testStrComparisons(String str1, String str2) {
    println(str1 == str2);
    println(str1 != str2);
    println(str1 < str2);
    println(str1 <= str2);
    println(str1 > str2);
    println(str1 >= str2);
}