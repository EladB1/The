fn main() -> int {
    String str = "hello, world";
    println(str);
    testStrIndex(str);
    testStrMethods(str);
    testCasts();
    testStrComparisons("hello", "halo");
    mut String a = "hi";
    String b = a;
    a = a + "!";
    println(a);
    println(b);
    return 0;
}

fn testStrIndex(String str) {
    println(str[1]);
    //println(str[27000]);
    println(str[^1]);
    println(str[1..4]);
    println(str[1..=4]);
    println(str.startsWith("hello"));
}

fn testStrMethods(String str) {
    println(str.reverse());
    testStartsWith(str);
    testEndsWith(str);
    testContains(str);
    println(str.toUpper());
    println("HELLO".toLower());
    testReplaceChar(str);
    testReplaceChar("");
    testReplaceString(str);
    testReplaceString("");
    testReplaceAllChar(str);
    testReplaceAllChar("");
    testReplaceAllString(str);
    testReplaceAllString("");
}

fn testStartsWith(String str) {
    println(str.startsWith("hello"));
    println(str.startsWith("helo"));
}

fn testEndsWith(String str) {
    println(str.endsWith("world"));
    println(str.endsWith("RLD"));
}

fn testContains(String str) {
    println(str.contains('l'));
    println(str.contains('L'));
    println(str.contains("ll"));
    println(str.contains("abc"));
    println(str.contains(""));
}

fn testTrim(String str) {
    print("  \n\tabc   \n\r\v ".trim());
    print(" \nabc".trimStart());
    println("abc\n\r  ".trimEnd());
}

fn testReplaceChar(String str) {
    println(str.replace('', '_'));
    println(str.replace('l', '_'));
    println(str.replace('l', 'l'));
    println(str.replace('l', ''));
}

fn testReplaceString(String str) {
    println(str.replace("", "(y)"));
    println(str.replace("ll", "(y)"));
    println(str.replace("ll", "ll"));
    println(str.replace("ll", ""));
}

fn testReplaceAllChar(String str) {
    println(str.replaceAll('', '_'));
    println(str.replaceAll('l', '_'));
    println(str.replaceAll('l', 'l'));
    println(str.replaceAll('l', ''));
}

fn testReplaceAllString(String str) {
    println(str.replaceAll("", "(y)"));
    println(str.replaceAll("ll", "(y)"));
    println(str.replaceAll("ll", "ll"));
    println(str.replaceAll("ll", ""));
}

fn testCasts() {
    println(92);
    println(1);
    println(-45);
    println('c');
    println(true);
    int64 i = -221;
    println(i);
}

fn testStrComparisons(String str1, String str2) {
    println(str1 == str2);
    println(str1 != str2);
    println(str1 < str2);
    println(str1 <= str2);
    println(str1 > str2);
    println(str1 >= str2);
}