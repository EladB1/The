struct S {
    int i;
    int j;
    char c;

    compare {
        fn equals(S other) -> bool {
            return this.i == other.i && this.j == other.j;
        }
    }
}

struct Empty {
    fn method() {
        println("In Empty");
    }
}

fn main() -> int {
    S s = S{
        i: 12,
        j: 51,
        c: 'a',
    };
    S s2 = S{
        i: 10012,
        j: 52342,
        c: 'z'
    };

    S s3 = S{
        i: 16,
        j: 25,
        c: ''
    };
    
    println(s.i);
    println(s.j);
    println(s.c);
    println(s);
    println(s2);
    println(s);
    println(s3);
    println(s == s2);
    println(s == s);
    Empty empty = Empty{};
    empty.method();
    return 0;
}