struct S {
    int i;
    /*private */int j;
    char c;

    cast {
        fn toString() -> String {
            String rep = i as String + c as String;
            return (this.i as String) + (c as String);
        }
    }

    compare {
        fn equals(S other) -> bool {
            println(other);
            return this.i == other.i && this.j == other.j;
        }
    }

    // fn Print() {
    //     println(this as String);
    // }
}

fn main() -> int {
    S s = S{
        i: 12,
        j: 51,
        c: 'a',
    };
    // S s2 = S{
    //     i: 121,
    //     j: 51,
    // };
    
    println(s.i);
    println(s.j);
    println(s.c);
    println(s);
    //println(s == s2);
    return 0;
}