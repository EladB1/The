fn main() -> int {
    S s = S{
        i: 12,
        j: 51,
        c: 'a',
    };
    S s2 = S{
        i: 10012,
        j: 52342,
        c: 'z'
    };

    S s3 = S{
        i: 16,
        j: 25,
        c: ''
    };
    
    println(s.i);
    println(s.j);
    println(s.c);
    println(s);
    println(s2);
    println(s);
    println(s3);
    println(s == s2);
    println(s == s);
    return 0;
}